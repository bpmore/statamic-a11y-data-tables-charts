{
    "name": "bpmore/statamic-a11y-data-tables-charts",
    "description": "Two fieldtypes that make it hard to publish an inaccessible data table or chart: one dataset, rendered as a correctly marked up table and as a server-rendered SVG chart with its data table beside it.",
    "keywords": [
        "statamic",
        "accessibility",
        "a11y",
        "wcag",
        "table",
        "chart",
        "svg"
    ],
    "license": "proprietary",
    "type": "statamic-addon",
    "homepage": "https://github.com/bpmore/statamic-a11y-data-tables-charts",
    "support": {
        "issues": "https://github.com/bpmore/statamic-a11y-data-tables-charts/issues",
        "source": "https://github.com/bpmore/statamic-a11y-data-tables-charts",
        "docs": "https://github.com/bpmore/statamic-a11y-data-tables-charts/blob/main/README.md"
    },
    "authors": [
        {
            "name": "Brent Passmore",
            "homepage": "https://hada.farm"
        }
    ],
    "require": {
        "php": "^8.2",
        "statamic/cms": "^6.31"
    },
    "require-dev": {
        "orchestra/testbench": "^10.11 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Bpmore\\A11yDataTablesCharts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Bpmore\\A11yDataTablesCharts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "extra": {
        "statamic": {
            "name": "A11y Data Tables & Charts",
            "slug": "statamic-a11y-data-tables-charts",
            "description": "Accessible data tables and charts. One dataset, two renderings, both correct."
        },
        "laravel": {
            "providers": [
                "Bpmore\\A11yDataTablesCharts\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "pixelfear/composer-dist-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
